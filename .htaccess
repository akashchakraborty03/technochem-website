RewriteEngine on

RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1 [NC,L,R]

RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^ %{REQUEST_URI}.html [NC,L]

Redirect 301 /index /home
RewriteRule ^home$ index.html [L]


# ----------------------------
# ✅ Browser Caching Section
# ----------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Images – cache for 1 month
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"

  # CSS, JS – cache for 1 week
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"

  # HTML, XML – cache for 1 day (so new changes show up faster)
  ExpiresByType text/html "access plus 1 day"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>

# Optional: Add cache-control headers for modern browsers
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|css|js|ico)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>
</IfModule>
